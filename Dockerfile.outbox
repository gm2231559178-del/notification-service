# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM rust:1.94-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV SQLX_OFFLINE=true

COPY Cargo.toml Cargo.lock ./
COPY .sqlx/        .sqlx/
COPY src/           src/
COPY crates/        crates/
COPY migrations/    migrations/
COPY config/        config/

# Build only the outbox-worker binary
RUN cargo build --release --bin outbox-worker

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/outbox-worker ./outbox-worker

# Drop privileges
RUN useradd -m -u 1001 appuser
USER appuser

ENTRYPOINT ["./outbox-worker"]
